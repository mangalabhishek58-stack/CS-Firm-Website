# Copy to backend/.env and adjust. Never commit the real .env file.
PORT=5000
NODE_ENV=development

# Frontend origin allowed by CORS (Vite dev server locally).
CORS_ORIGIN=http://localhost:5173

# Max enquiry submissions per IP per 15 minutes.
ENQUIRY_RATE_LIMIT_MAX=5

# --- Email notifications for new enquiries (SMTP) ---
# Leave blank to skip email in development (enquiries are only logged).
# In production, enquiries are rejected with 503 until these are set.
#
# Gmail example: turn on 2-Step Verification for the account, create an
# App Password (Google Account > Security > App passwords) and use it as
# SMTP_PASS. Never use the normal Gmail password here.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Sender shown on the notification. For Gmail this must be SMTP_USER's address.
EMAIL_FROM=Vibhor Associates Website <your-address@gmail.com>

# Inbox that receives new enquiries.
ENQUIRY_NOTIFY_TO=mangalabhishek12@gmail.com
