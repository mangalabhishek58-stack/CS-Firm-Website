# Copy to frontend/.env.local to override. Everything here is visible in the
# browser - never put secrets in VITE_ variables.
VITE_API_BASE_URL=http://localhost:5000

# false (default) = send enquiries to the backend at VITE_API_BASE_URL.
# true = fake API responses, so the form works without the backend.
VITE_USE_MOCK_API=false
